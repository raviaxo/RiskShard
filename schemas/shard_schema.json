{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RiskShard Scenario Schema",
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "currency": { "type": "string" },
        "benchmark_status": { "type": "string" },
        "scenario_stage": {
          "type": "string",
          "enum": ["governed_starter", "demo_fixture"]
        },
        "description": { "type": "string" },
        "source": { "type": "string" }
      },
      "required": ["name"]
    },
    "impact": {
      "type": "object",
      "properties": {
        "min": { "type": "number" },
        "likely": { "type": "number" },
        "max": { "type": "number" }
      },
      "required": ["min", "likely", "max"]
    },
    "frequency": {
      "type": "object",
      "properties": {
        "min": { "type": "number" },
        "likely": { "type": "number" },
        "max": { "type": "number" }
      },
      "required": ["min", "likely", "max"]
    }
  },
  "required": ["metadata", "impact", "frequency"]
}
