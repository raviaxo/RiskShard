{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RiskShard Scenario Schema",
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "currency": { "type": "string" },
        "benchmark_status": { "type": "string" },
        "scenario_stage": {
          "type": "string",
          "enum": ["governed_starter", "demo_fixture"]
        },
        "description": { "type": "string" },
        "source": { "type": "string" }
      },
      "required": ["name"]
    },
    "impact": {
      "type": "object",
      "properties": {
        "min": { "type": "number" },
        "likely": { "type": "number" },
        "max": { "type": "number" }
      },
      "required": ["min", "likely", "max"]
    },
    "frequency": {
      "type": "object",
      "properties": {
        "min": { "type": "number" },
        "likely": { "type": "number" },
        "max": { "type": "number" }
      },
      "required": ["min", "likely", "max"]
    },
    "loss_stages": {
      "description": "Optional conditional downstream loss stages (ADR-0001). Each stage adds a gated impact to the initiating event's impact per Monte Carlo trial. Bounded to keep it honestly sourceable. Stage impacts carry no per-stage currency: they MUST be expressed in the scenario's metadata.currency, since they are summed directly onto the initiating impact. The calibration pipeline enforces this by converting each stage bound to the profile target_currency; hand-authored stages must match the scenario currency.",
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "loss_mode": { "type": "string" },
          "conditional_probability": {
            "description": "P(this stage occurs | the initiating event occurred).",
            "type": "object",
            "properties": {
              "min": { "type": "number", "minimum": 0, "maximum": 1 },
              "likely": { "type": "number", "minimum": 0, "maximum": 1 },
              "max": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "required": ["min", "likely", "max"]
          },
          "impact": {
            "type": "object",
            "properties": {
              "min": { "type": "number" },
              "likely": { "type": "number" },
              "max": { "type": "number" }
            },
            "required": ["min", "likely", "max"]
          }
        },
        "required": ["loss_mode", "conditional_probability", "impact"]
      }
    }
  },
  "required": ["metadata", "impact", "frequency"]
}
