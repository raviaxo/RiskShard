{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RiskShard Evidence Records Schema",
  "type": "object",
  "properties": {
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "parameter": { "type": "string" },
          "value": { "type": "number" },
          "unit": { "type": "string" },
          "currency": { "type": "string" },
          "source_id": { "type": "string" },
          "source_ids": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "source_name": { "type": "string" },
          "source_type": { "type": "string" },
          "source_url_or_citation": { "type": "string" },
          "publication_date": { "type": "string" },
          "extraction_date": { "type": "string" },
          "citation_detail": { "type": "string" },
          "extraction_notes": { "type": "string" },
          "normalization_notes": { "type": "string" },
          "limitations": { "type": "string" },
          "confidence": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "evidence_type": {
            "type": "string",
            "enum": ["source_backed", "estimated", "synthetic"]
          },
          "measurement_basis": {
            "type": "string",
            "description": "What quantity this record measures (ADR-0007). Distinct from source_type (how it was collected) and population_match (who was measured).",
            "enum": [
              "org_prevalence_incident",
              "org_prevalence_loss_event",
              "org_prevalence_threshold",
              "reported_case_rate",
              "event_rate_per_entity",
              "attribution_share",
              "conditional_probability",
              "mean_total_event_cost",
              "median_total_event_cost",
              "cost_component",
              "single_documented_event_loss",
              "perceived_cost_self_reported",
              "observed_extremum",
              "statutory_penalty_cap",
              "regulatory_penalty_issued",
              "aggregate_population_loss",
              "interpretive_estimate",
              "context_statistic"
            ]
          },
          "exceedance_basis": {
            "type": "string",
            "description": "What is known about this value being exceeded (ADR-0008). Required on any record anchoring an impact maximum. `none_known` is a legal and currently common answer — it must be declared, never left silent.",
            "enum": [
              "modeled_quantile",
              "observed_rank",
              "population_ceiling",
              "none_known"
            ]
          },
          "exceedance_detail": {
            "type": "string",
            "description": "The exceedance statement itself, when one exists — e.g. the percentile and its distribution, or the rank and N. Required when exceedance_basis is modeled_quantile or observed_rank; meaningless for none_known."
          },
          "applicability": {
            "type": "object",
            "properties": {
              "industries": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1
              },
              "countries": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1
              },
              "company_size_bands": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1
              },
              "threats": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1
              }
            },
            "required": ["industries", "countries", "company_size_bands", "threats"]
          }
        },
        "required": [
          "id",
          "title",
          "parameter",
          "value",
          "unit",
          "source_name",
          "source_type",
          "source_url_or_citation",
          "publication_date",
          "extraction_date",
          "extraction_notes",
          "normalization_notes",
          "limitations",
          "confidence",
          "evidence_type",
          "measurement_basis",
          "applicability"
        ],
        "allOf": [
          {
            "$comment": "ADR-0013: fit is computed against a target, so it is not stored on the record. `population_match` was required here for source_backed records until 2026-08-15; it is now refused rather than ignored, so a contributor working from an old example is told instead of authoring a field nothing reads. The facets it recorded are derived from `applicability` by engine/provenance.py.",
            "not": { "required": ["population_match"] }
          },
          {
            "$comment": "ADR-0008: a record anchoring an impact maximum must say what, if anything, is known about being exceeded. Matches `impact.max` and staged forms such as `loss_stage.regulatory_penalty.impact.max`.",
            "if": {
              "properties": { "parameter": { "pattern": "(^|\\.)impact\\.max$" } },
              "required": ["parameter"]
            },
            "then": {
              "required": ["exceedance_basis"]
            }
          },
          {
            "$comment": "ADR-0008: an exceedance statement that claims a quantile or a rank must carry the statement itself, or the declaration is empty.",
            "if": {
              "properties": {
                "exceedance_basis": { "enum": ["modeled_quantile", "observed_rank"] }
              },
              "required": ["exceedance_basis"]
            },
            "then": {
              "required": ["exceedance_detail"]
            }
          }
        ]
      }
    }
  },
  "required": ["records"]
}
