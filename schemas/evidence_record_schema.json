{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RiskShard Evidence Records Schema",
  "type": "object",
  "properties": {
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "parameter": { "type": "string" },
          "value": { "type": "number" },
          "unit": { "type": "string" },
          "currency": { "type": "string" },
          "source_id": { "type": "string" },
          "source_ids": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "source_name": { "type": "string" },
          "source_type": { "type": "string" },
          "source_url_or_citation": { "type": "string" },
          "publication_date": { "type": "string" },
          "extraction_date": { "type": "string" },
          "citation_detail": { "type": "string" },
          "extraction_notes": { "type": "string" },
          "normalization_notes": { "type": "string" },
          "limitations": { "type": "string" },
          "confidence": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "evidence_type": {
            "type": "string",
            "enum": ["source_backed", "estimated", "synthetic"]
          },
          "measurement_basis": {
            "type": "string",
            "description": "What quantity this record measures (ADR-0007). Distinct from source_type (how it was collected) and population_match (who was measured).",
            "enum": [
              "org_prevalence_incident",
              "org_prevalence_loss_event",
              "org_prevalence_threshold",
              "reported_case_rate",
              "event_rate_per_entity",
              "attribution_share",
              "conditional_probability",
              "mean_total_event_cost",
              "median_total_event_cost",
              "cost_component",
              "single_documented_event_loss",
              "perceived_cost_self_reported",
              "observed_extremum",
              "statutory_penalty_cap",
              "regulatory_penalty_issued",
              "aggregate_population_loss",
              "interpretive_estimate",
              "context_statistic"
            ]
          },
          "population_match": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": ["matched", "bridged"]
              },
              "bridged_on": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["country", "sector", "size", "threat"]
                },
                "minItems": 1
              }
            },
            "required": ["status"],
            "if": {
              "properties": { "status": { "const": "bridged" } }
            },
            "then": {
              "required": ["status", "bridged_on"]
            },
            "else": {
              "not": { "required": ["bridged_on"] }
            }
          },
          "applicability": {
            "type": "object",
            "properties": {
              "industries": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1
              },
              "countries": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1
              },
              "company_size_bands": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1
              },
              "threats": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1
              }
            },
            "required": ["industries", "countries", "company_size_bands", "threats"]
          }
        },
        "required": [
          "id",
          "title",
          "parameter",
          "value",
          "unit",
          "source_name",
          "source_type",
          "source_url_or_citation",
          "publication_date",
          "extraction_date",
          "extraction_notes",
          "normalization_notes",
          "limitations",
          "confidence",
          "evidence_type",
          "measurement_basis",
          "applicability"
        ],
        "if": {
          "properties": { "evidence_type": { "const": "source_backed" } },
          "required": ["evidence_type"]
        },
        "then": {
          "required": ["population_match"]
        }
      }
    }
  },
  "required": ["records"]
}
