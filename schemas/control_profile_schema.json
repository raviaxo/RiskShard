{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RiskShard Control Profile Schema",
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["frequency_reduction", "impact_reduction"]
          },
          "reduction_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": ["type", "reduction_pct"]
      }
    }
  },
  "required": ["controls"]
}
