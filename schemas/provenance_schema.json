{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RiskShard Provenance Schema",
  "type": "object",
  "properties": {
    "scenario_name": { "type": "string" },
    "summary": { "type": "string" },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "parameter": { "type": "string" },
          "source_name": { "type": "string" },
          "source_type": { "type": "string" },
          "source_url_or_citation": { "type": "string" },
          "publication_date": { "type": "string" },
          "extraction_date": { "type": "string" },
          "extraction_notes": { "type": "string" },
          "applicability": { "type": "string" },
          "confidence": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "evidence_type": {
            "type": "string",
            "enum": ["source_backed", "estimated", "synthetic"]
          }
        },
        "required": [
          "parameter",
          "source_name",
          "source_type",
          "source_url_or_citation",
          "publication_date",
          "extraction_date",
          "extraction_notes",
          "applicability",
          "confidence",
          "evidence_type"
        ]
      }
    }
  },
  "required": ["scenario_name", "records"]
}
